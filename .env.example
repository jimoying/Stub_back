APP_ENV=development
HTTP_ADDR=:8080
HTTP_PORT=8588
SHORT_LINKS_IMAGE=short-links-back:local
PUBLIC_BASE_URL=https://s.example.com
POSTGRES_DB=short_links
POSTGRES_USER=short_links
POSTGRES_PASSWORD=replace-with-a-random-password
DATABASE_URL=postgres://short_links:replace-with-a-random-password@postgres:5432/short_links?sslmode=disable
REDIS_URL=redis://redis:6379/0
SHORT_LINKS_PROXY_NETWORK=web_net
SHORT_LINKS_STORAGE_NETWORK=minio_net

# 首次启动数据库且尚无管理员时必填；初始化完成后应从部署环境移除。
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-long-random-password

# 邮箱验证码 HMAC 密钥，建议使用至少 32 字节随机值。
EMAIL_CODE_HMAC_KEY=replace-with-at-least-32-random-bytes
SHORT_CODE_HMAC_KEY=replace-with-at-least-32-random-bytes

# SMTP 配置；用户名和密码可留空以使用无认证 SMTP 中继。
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Short Links <no-reply@example.com>
SMTP_TLS_MODE=starttls

# MinIO 内网 API 地址与公网签名地址分离。首期未配置时素材路由返回服务未配置。
MINIO_INTERNAL_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=https://thing.example.com
MINIO_ACCESS_KEY=short-links
MINIO_SECRET_KEY=replace-me
MINIO_USE_SSL=false

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,capacitor://localhost,https://localhost
TRUSTED_PROXY_CIDRS=
